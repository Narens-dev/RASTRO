# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3100 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Base URL of the RASTRO Express API (repo root `src/` — search, scoreEngine,
# contract tracking, opportunities, AI summary). Every app/api/** route proxies
# to it server-side; the browser never calls it directly. Defaults to the
# local Express dev server.
RASTRO_API_URL=http://localhost:3000

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=
