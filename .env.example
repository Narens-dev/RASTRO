# Fuente de datos: "croma" para conectar al MCP real, "mock" para fixtures locales
DATA_SOURCE=mock

# Endpoint MCP de Croma y credencial (solo si DATA_SOURCE=croma)
CROMA_MCP_URL=https://api.croma.run/mcp
CROMA_API_KEY=

# Resumen ejecutivo con IA (opcional — el módulo se degrada de forma segura si falta)
ANTHROPIC_API_KEY=

# TTL de caché en memoria, en milisegundos (10 minutos por defecto)
CACHE_TTL_MS=600000

PORT=3000
