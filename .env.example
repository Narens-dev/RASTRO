# Fuente de datos: "croma" para conectar al MCP real, "mock" para fixtures locales
DATA_SOURCE=mock

# Endpoint MCP de Croma y credencial (solo se usan si DATA_SOURCE=croma)
CROMA_MCP_URL=https://api.croma.run/mcp
CROMA_API_KEY=

# Resumen ejecutivo con IA (opcional). Sin esta variable, los endpoints de
# resumen responden { available: false } de forma segura, sin romper nada.
ANTHROPIC_API_KEY=

# TTL de la caché en memoria, en milisegundos (10 minutos por defecto)
CACHE_TTL_MS=600000

# Puerto donde escucha la API Express
PORT=3000

# Firma los tokens de sesión de empresa (JWT). Cambiar el valor por defecto
# antes de cualquier despliegue que no sea puramente local/demo.
JWT_SECRET=rastro-dev-secret-cambiar-en-produccion

# Correos (separados por coma) a los que el registro de empresa asigna el rol
# "estado" en vez de "empresa". Sin esta variable, todo registro es "empresa".
RASTRO_ESTADO_EMAILS=

# Proveedor de envío de correo. "mock" (por defecto) registra cada envío en
# data/outbox_emails.json en vez de entregarlo de verdad. Cualquier otro valor
# cae de vuelta a mock hasta que se implemente el adaptador correspondiente.
EMAIL_PROVIDER=mock

# Proveedor de envío de WhatsApp. Mismo comportamiento que EMAIL_PROVIDER:
# "mock" (por defecto) registra el código en data/outbox_whatsapp.json y lo
# devuelve en la respuesta de la API en vez de enviarlo de verdad.
WHATSAPP_PROVIDER=mock

# Cada cuánto se sondean oportunidades nuevas para disparar alertas, en
# milisegundos (15 minutos por defecto). También se puede forzar sin esperar
# el intervalo con POST /api/opportunities/poll.
OPPORTUNITY_POLL_INTERVAL_MS=900000

# Carpeta de persistencia JSON (empresas, outbox de correo/WhatsApp,
# oportunidades ya notificadas). "./data" por defecto.
DATA_DIR=
